// Django-style view module written in Aura.
//
// Aura transpiles to Python, so Django views/urls are ordinary Python interop.
// Install Django (`pip install django`) and wire this module into a project's
// `urls.py`:
//
//     from examples.django_views import urlpatterns
//
// Aura's `extends`-only class syntax and explicit `return` keep the view code
// identical in shape to idiomatic Django.

import py.django.http as http
from py.django.urls import path

def home(request) {
  return http.HttpResponse("Aura + Django")
}

def health(request) {
  return http.JsonResponse({"status": "ok"})
}

let urlpatterns = [
  path("", home),
  path("health", health),
]

def main() {
  print(f"{len(urlpatterns)} routes registered")
}