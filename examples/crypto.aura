// Cryptography: hashing, HMAC, and post-quantum key exchange/signatures.
//
// The classical primitives (SHA-3, HMAC, HKDF, secure randomness) are real.
// The post-quantum operations use a pluggable backend: install
// "aura-language[pqc]" for a vetted implementation; otherwise a bundled
// reference backend is used for demonstration.

import stdlib.crypto as crypto

// Which backend is active?
print(f"backend: {crypto.backend_info().name}")

// Hashing (SHA-3 and SHAKE are post-quantum-resistant).
print(crypto.sha3_256("hello").length())
print(crypto.sha256("hello").length())

// Message authentication.
let key = crypto.random_bytes(32)
let tag = crypto.hmac_sha3_256(key, "authenticated message")
print(tag.length())

// Key derivation from a shared secret.
let derived = crypto.hkdf_sha256("input keying material", 32)
print(derived.length())

// Post-quantum key encapsulation (ML-KEM).
let kp = crypto.kem_keypair()
let enc = crypto.kem_encapsulate(kp.public_key)
let shared = crypto.kem_decapsulate(kp.secret_key, enc.ciphertext)
print(f"kem agrees: {shared == enc.shared_secret}")

// Post-quantum signatures (ML-DSA).
let signer = crypto.dsa_keypair()
let sig = crypto.dsa_sign(signer.secret_key, "transfer 10 to bob")
print(f"signature valid: {crypto.dsa_verify(signer.public_key, 'transfer 10 to bob', sig)}")
print(f"tampered rejected: {not crypto.dsa_verify(signer.public_key, 'transfer 999 to bob', sig)}")