# A tour of Aura's core features.

struct Point { x: int, y: int }

enum Shape {
    Circle(int),
    Rectangle(int, int),
}

fn area(shape) -> int {
    return match shape {
        Circle(r) -> 3 * r * r
        Rectangle(w, h) -> w * h
    }
}

fn fibonacci(n) -> int {
    if n < 2 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() {
    # Immutable by default; `let mut` opts into reassignment.
    let name = "Aura"
    let mut total = 0

    for i in range(1, 6) {
        total = total + i
    }

    print(f"{name}: sum 1..5 = {total}")
    print(f"fib(10) = {fibonacci(10)}")

    let origin = Point { x: 0, y: 0 }
    print(f"origin = ({origin.x}, {origin.y})")

    print(f"circle area = {area(Circle(2))}")
    print(f"rect area = {area(Rectangle(3, 4))}")

    # Lists, pipelines, closures, and comprehensions-by-method.
    let xs = [1, 2, 3, 4, 5, 6]
    let evens = xs.filter((x) -> x % 2 == 0)
    let doubled = evens.map((x) -> x * 2)
    print(doubled)
    print(xs |> len)
}
