// real/sales_pipeline.aura — a data-processing pipeline with the pipe operator.
//
// Reads an in-memory sales dataset, then cleans, filters, groups, and
// aggregates it with `|>` stages. Demonstrates:
//   * the pipe operator with stdlib `map`/`filter`/`reduce` (data-first)
//   * grouping with a dict and aggregation
//   * sorting and formatting a report
//
// Run:
//   aura run examples/real/sales_pipeline.aura

import stdlib.collections as collections
from stdlib.collections import map, filter, reduce, list_sort

// (region, product, units, unit_price)
let SALES = [
  ("north", "widget", 12, 9.5),
  ("south", "widget", 7, 9.5),
  ("north", "gadget", 3, 24.0),
  ("east",  "widget", 20, 9.5),
  ("south", "gadget", 5, 24.0),
  ("east",  "gadget", 2, 24.0),
  ("north", "widget", 8, 9.5),
  ("west",  "gizmo", 15, 4.0),
  ("west",  "widget", 6, 9.5),
  ("south", "widget", 4, 9.5),
]

def revenue(row) -> float {
  return row[2] * row[3]
}

def region_of(row) -> str {
  return row[0]
}

def main() {
  // 1. Compute revenue per row.
  let with_revenue = SALES |> map((row) => (region_of(row), revenue(row)))

  // 2. Keep only rows above a threshold.
  let significant = with_revenue |> filter((pair) => pair[1] >= 50.0)

  // 3. Group totals by region.
  let mut by_region = {}
  for pair in significant {
    let region = pair[0]
    by_region[region] = (by_region.get(region, 0.0) ?: 0.0) + pair[1]
  }

  // 4. Total and count across everything.
  let total = with_revenue |> reduce((acc, pair) => acc + pair[1], 0.0)
  let row_count = len(with_revenue)

  // 5. Build a sorted report.
  let report = [(region, round(amount, 2)) for region, amount in by_region.items()]
  let ranked = list_sort(report, key=(pair) => pair[1], reverse=true)

  print("Sales report")
  print("============")
  print(f"rows processed:   {row_count}")
  print(f"total revenue:    {round(total, 2)}")
  print(f"significant rows: {len(significant)}")
  print("")
  print("revenue by region (>= 50):")
  for entry in ranked {
    print(f"  {entry[0]:<6}  {entry[1]}")
  }

  let top_region = ranked[0][0]
  print("")
  print(f"top region: {top_region}")
}
