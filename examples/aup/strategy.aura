// AUP-03: Strategy pattern via traits.
//
// A trait is an interface; concrete classes implement it and share call sites.

trait Discount {
  public def apply(price: float) -> float
}

class NoDiscount implements Discount {
  public def apply(price: float) -> float { return price }
}

class PercentOff implements Discount {
  public let percent: float = 0.0

  public def new(percent: float) { self.percent = percent }

  public def apply(price: float) -> float {
    return price * (1.0 - self.percent / 100.0)
  }
}

class BlackFriday implements Discount {
  public def apply(price: float) -> float { return price * 0.5 }
}

def total(prices, strategy: Discount) -> float {
  let mut sum = 0.0
  for price in prices { sum += strategy.apply(price) }
  return sum
}

def main() {
  let prices = [100.0, 50.0]
  print(total(prices, NoDiscount()))
  print(total(prices, PercentOff(10.0)))
  print(total(prices, BlackFriday()))
}