// AUP-05: Typed error handling.
//
// `throw` raises an exception object; `catch Type as e` handles specific
// classes; `try` can also be used as an expression.

def parse_int(text) -> int {
  guard text.length() > 0 else {
    throw ValueError("empty input")
  }
  return int(text)
}

def safe_divide(a, b) -> float {
  if b == 0 {
    throw ValueError("division by zero")
  }
  return a / b
}

def main() {
  // Statement form with a typed catch and a finally.
  try {
    print(safe_divide(10, 2))
    print(parse_int("not a number"))
  } catch ValueError as e {
    print(f"ValueError: {e}")
  } finally {
    print("done")
  }

  // Expression form: the try yields a value.
  let label = try {
    f"parsed: {parse_int('42')}"
  } catch Error as e {
    "failed"
  }
  print(label)
}