// AUP-02: Builder pattern.
//
// A mutable object whose methods return `self` allows left-to-right chaining.

class Query {
  public let table: str = ""
  public let columns: list = []
  public let limit_value: int = 0

  public def new(table: str) {
    self.table = table
  }

  public def select(*names) {
    self.columns = names
    return self
  }

  public def limit(n: int) {
    self.limit_value = n
    return self
  }

  public def build() -> str {
    let mut cols = " * "
    if self.columns.length() > 0 {
      cols = " " + ", ".join(self.columns) + " "
    }
    let mut sql = f"SELECT{cols}FROM {self.table}"
    if self.limit_value > 0 {
      sql += f" LIMIT {self.limit_value}"
    }
    return sql
  }
}

def main() {
  let query = Query("users").select("id", "name").limit(10).build()
  print(query)
}