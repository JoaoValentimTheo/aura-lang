// AUP-10: Hybrid secure message (post-quantum KEM + authenticated encryption).
//
// Combine ML-KEM to establish a shared secret with HMAC-SHA3 for integrity.
// The KEM needs a vetted backend for real security; install the `pqc` extra.
//
// This demonstrates the shape of a hybrid handshake. The XOR "encryption" here
// is illustrative only — use a real AEAD (e.g. AES-GCM/ChaCha20-Poly1305) in
// production.

import stdlib.crypto as crypto

// Sender has the recipient's public key; this produces a ciphertext + tag.
def seal(public_key, message) -> dict {
  let enc = crypto.kem_encapsulate(public_key)
  let key = crypto.hkdf_sha256(enc.shared_secret, 32, info: b"message")
  let tag = crypto.hmac_sha3_256(key, message)
  return {"ciphertext": enc.ciphertext, "tag": tag}
}

// Recipient recovers the secret and verifies integrity.
def open(secret_key, envelope, message, algorithm: str) -> bool {
  let shared = crypto.kem_decapsulate(secret_key, envelope.ciphertext, algorithm)
  let key = crypto.hkdf_sha256(shared, 32, info: b"message")
  let expected = crypto.hmac_sha3_256(key, message)
  return crypto.constant_time_compare(expected, envelope.tag)
}

def main() {
  let recipient = crypto.kem_keypair()
  let message = "attack at dawn"
  let envelope = seal(recipient.public_key, message)

  print(f"verified: {open(recipient.secret_key, envelope, message, recipient.algorithm)}")
  print(f"tampered: {open(recipient.secret_key, envelope, 'attack at dusk', recipient.algorithm)}")
}