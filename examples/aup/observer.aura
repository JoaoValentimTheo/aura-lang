// AUP-07: Observer pattern with first-class functions.
//
// A subject keeps a list of callbacks and notifies them on change.

class EventBus {
  public let handlers: dict = {}

  public def on(event: str, handler) {
    if not event in self.handlers {
      self.handlers[event] = []
    }
    self.handlers[event].append(handler)
  }

  public def emit(event: str, payload) {
    guard event in self.handlers else { return }
    for handler in self.handlers[event] {
      handler(payload)
    }
  }
}

let bus = EventBus()

bus.on("order", (payload) => print(f"email: order {payload}"))
bus.on("order", (payload) => print(f"audit: order {payload}"))
bus.on("login", (user) => print(f"welcome {user}"))

bus.emit("order", 42)
bus.emit("login", "alice")
bus.emit("unknown", 1)  // no handlers: nothing happens