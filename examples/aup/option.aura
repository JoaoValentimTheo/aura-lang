// AUP-01: Option (result-or-null) pattern.
//
// Aura has no built-in Option type, but `T | none`, `guard`, `?.` and `??`
// compose into one. Functions return `none` on failure; callers either guard
// early or fall back with `??`.

def parse_positive(text) -> int | none {
  guard text.length() > 0 else { return none }
  let value = try {
    int(text)
  } catch e {
    -1
  }
  guard value > 0 else { return none }
  return value
}

def describe(text) -> str {
  let value = parse_positive(text)
  return value ?? -1
}

// Caller handles absence explicitly with an early-exit guard.
def report(text) {
  guard parse_positive(text) != none else {
    print(f"{text}: not a positive number")
    return
  }
  print(f"{text}: ok")
}

def main() {
  report("42")
  report("-3")
  report("abc")
  print(describe("7"))
  print(describe("nope"))
}