// AUP-08: Resource management with a context manager.
//
// `with` calls `enter()` on entry and `exit()` on exit, even if the body
// throws, so cleanup always runs.

class Timer {
  public let label: str = ""
  public let start: float = 0.0

  public def new(label: str) { self.label = label }

  public def enter() {
    self.start = 0.0
    print(f"[{self.label}] start")
    return self
  }

  public def exit(exc_type, exc, tb) {
    print(f"[{self.label}] end")
  }
}

with Timer("load") as t {
  print("working...")
}

// Nested context managers run their exit blocks in reverse order.
with Timer("outer") as a {
  with Timer("inner") as b {
    print("body")
  }
}