def classify(value) -> str {
  match value {
    case 0 { return "zero" }
    case 1 { return "one" }
    case n if n > 100 { return "big" }
    case n if n > 0 { return "positive" }
    case n if n < 0 { return "negative" }
    case _ { return "other" }
  }
  return "unreachable"
}

for value in [0, 1, 42, 200, -7] {
  print(f"{value} -> {classify(value)}")
}

// Match on a string.
def command(name) -> str {
  match name {
    case "quit" { return "exiting" }
    case "help" { return "showing help" }
    case _ { return "unknown command" }
  }
  return ""
}

for cmd in ["quit", "help", "run"] {
  print(f"{cmd}: {command(cmd)}")
}

// Destructuring with lists.
def sum_pair(pair) -> int {
  match pair {
    case [a, b] { return a + b }
    case _ { return 0 }
  }
  return 0
}

print(sum_pair([3, 4]))
print(sum_pair([1, 2]))