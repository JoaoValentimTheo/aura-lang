// Flet desktop UI written in Aura.
//
// Flet is a Python UI framework; Aura drives it through normal interop. The
// view builder takes a page object and adds real Flet controls to it, so it
// can be exercised without opening a window: `main` builds the controls and
// reports them. To run the real app, pass the builder to `flet.app(target=build)`.

import flet

// The tiny slice of Flet's page API the builder uses. A real `flet.Page` is
// created by the runtime, so tests and headless runs use this stand-in.
class DemoPage {
  public let mut title: str = ""
  public let mut controls = []

  public def add(*items) {
    for item in items {
      self.controls.append(item)
    }
  }

  public def update() {
    print(f"rendered {len(self.controls)} controls")
  }
}

def build(page) {
  page.title = "Aura + Flet"

  let counter = flet.Text("0")
  let mut count = 0

  def on_click(e) {
    count += 1
    counter.value = str(count)
    page.update()
  }

  page.add(
    flet.Text("Hello from Aura", size=24),
    counter,
    flet.Button("Increment", on_click=on_click),
  )
}

def main() {
  let page = DemoPage()
  build(page)
  print(f"{len(page.controls)} controls on '{page.title}'")
}