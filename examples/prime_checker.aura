def is_prime(n) -> bool {
  if n < 2 { return false }
  if n == 2 { return true }
  if n % 2 == 0 { return false }

  let mut i = 3
  while i * i <= n {
    if n % i == 0 { return false }
    i += 2
  }
  return true
}

let primes = [n for n in range(2, 30) if is_prime(n)]
print(primes)

for n in primes {
  print(f"{n} is prime")
}