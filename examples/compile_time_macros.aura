// Compile-time macros (AuraMacroFactory).
//
// These are expanded by the transpiler *before* any Python is emitted: the
// macro receives its operands as quoted AST and returns replacement AST, so
// nothing survives to runtime unless the expansion chooses to emit it. This is
// a stronger tier than the runtime decorators in `macros.aura`.
//
//     assert_eq(a, b)   evaluate both once, then assert equality
//     assert_ne(a, b)   evaluate both once, then assert inequality
//     static_assert(x)  checked at compile time; a non-literal is an error
//     identity(x)       expands to x
//     stringify(x)      folds a literal to a string at compile time
//     swap(a, b)        exchange two lvalues via a hygienic temporary
//     debug_value(x)    print "x = <value>" once, then yield the value
//
// A macro that introduces bindings uses hygienic names, so it can never
// capture a local at the call site.

import macros

def main() {
  // assert_eq evaluates each operand exactly once and shows both on failure.
  assert_eq(2 + 2, 4)
  assert_ne("a", "b")

  // static_assert is resolved while compiling; there is no runtime cost.
  static_assert(true)

  // swap expands to a binding plus two assignments, so both locals change.
  let mut a = 1
  let mut b = 2
  swap(a, b)
  print(a, b)

  // identity disappears from the emitted Python.
  print(identity(41) + 1)

  // stringify folds the literal at compile time, so it emits "42".
  print(stringify(42))

  // debug_value prints a labelled value and returns it, evaluating once.
  print(debug_value(a))
}