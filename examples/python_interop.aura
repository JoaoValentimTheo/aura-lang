// Python interop: reach host Python through the `py.` namespace.
import py.os as os
import py.sys as sys
import py.math as math
from py.json import dumps, loads

// For dynamic access, Aura also ships the `python` bridge.
import python

def main() {
  let payload = {"name": "aura", "ok": true}
  let encoded = dumps(payload)
  print("json:", encoded)
  print("roundtrip:", loads(encoded)["name"])

  print("os.name:", os.name)
  print("sqrt(2):", math.sqrt(2))
  print("platform:", sys.platform)

  // The bridge handles dynamic names and introspection.
  let re = python.import_module("re")
  print("has match:", python.hasattr(re, "match"))
}
