// OOP: Static Members
class BaseC68458Sm {
    public static let instance_count: int = 0
    public static def increment_count() -> void { BaseC68458Sm.instance_count = BaseC68458Sm.instance_count + 1; }
    
    public let id: int
    
    public def new(id: int) {
        self.id = id;
        BaseC68458Sm.increment_count();
    }
    
    public def get_id() -> int { return self.id; }
}

let obj1 = BaseC68458Sm(id: 1);
let obj2 = BaseC68458Sm(id: 2);
let obj3 = BaseC68458Sm(id: 3);

print(BaseC68458Sm.instance_count);
print(obj1.get_id());
print(obj3.get_id());
