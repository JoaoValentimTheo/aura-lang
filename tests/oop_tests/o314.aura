// OOP: Builder Pattern
class AbstractC73074NfBuilder {
    private let name: str = ""
    private let age: int = 0
    private let email: str = ""
    
    public def with_name(n: str) -> AbstractC73074NfBuilder {
        self.name = n;
        return self;
    }
    
    public def with_age(a: int) -> AbstractC73074NfBuilder {
        self.age = a;
        return self;
    }
    
    public def build() -> AbstractC73074Nf {
        return AbstractC73074Nf(name: self.name, age: self.age, email: self.email);
    }
}

class AbstractC73074Nf {
    public let name: str
    public let age: int
    public let email: str
    
    public def new(name: str, age: int, email: str = "") {
        self.name = name;
        self.age = age;
        self.email = email;
    }
}

let obj = AbstractC73074NfBuilder().with_name("Aura").with_age(30).build();
print(obj.name);
print(obj.age);
