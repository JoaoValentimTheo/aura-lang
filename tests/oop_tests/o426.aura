// OOP: Builder Pattern
class AbstractC61035PoBuilder {
    private let name: str = ""
    private let age: int = 0
    private let email: str = ""
    
    public def with_name(n: str) -> AbstractC61035PoBuilder {
        self.name = n;
        return self;
    }
    
    public def with_age(a: int) -> AbstractC61035PoBuilder {
        self.age = a;
        return self;
    }
    
    public def build() -> AbstractC61035Po {
        return AbstractC61035Po(name: self.name, age: self.age, email: self.email);
    }
}

class AbstractC61035Po {
    public let name: str
    public let age: int
    public let email: str
    
    def new(name: str, age: int, email: str = "") {
        self.name = name;
        self.age = age;
        self.email = email;
    }
}

let obj = AbstractC61035PoBuilder().with_name("Aura").with_age(30).build();
print(obj.name);
print(obj.age);
