// OOP: Polymorphism
class AbstractC99480Fw {
    public def render() -> str { return "base"; }
}

class C84565Sh(AbstractC99480Fw) {
    public def render() -> str { return "child1"; }
}

class ConcreteC73323Hl(AbstractC99480Fw) {
    public def render() -> str { return "child2"; }
}

let objects = [AbstractC99480Fw(), C84565Sh(), ConcreteC73323Hl()];
for obj in objects {
    print(obj.render());
}
