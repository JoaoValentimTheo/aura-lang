// OOP: Static Factory Pattern
class RealC49821Tv {
    private let value: int
    
    def new(value: int) { self.value = value; }
    
    public def get_value() -> int { return self.value; }
    
    public static def create_default() -> RealC49821Tv {
        return RealC49821Tv(value: 42);
    }
    
    public static def create_custom(val: int) -> RealC49821Tv {
        return RealC49821Tv(value: val);
    }
}

let obj1 = RealC49821Tv.create_default();
let obj2 = RealC49821Tv.create_custom(31);

print(obj1.get_value());
print(obj2.get_value());
