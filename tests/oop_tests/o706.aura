// OOP: Builder Pattern
class C51351VuBuilder {
    private let name: str = ""
    private let age: int = 0
    private let email: str = ""
    
    public def with_name(n: str) -> C51351VuBuilder {
        self.name = n;
        return self;
    }
    
    public def with_age(a: int) -> C51351VuBuilder {
        self.age = a;
        return self;
    }
    
    public def build() -> C51351Vu {
        return C51351Vu(name: self.name, age: self.age, email: self.email);
    }
}

class C51351Vu {
    public let name: str
    public let age: int
    public let email: str
    
    public def new(name: str, age: int, email: str = "") {
        self.name = name;
        self.age = age;
        self.email = email;
    }
}

let obj = C51351VuBuilder().with_name("Aura").with_age(30).build();
print(obj.name);
print(obj.age);
