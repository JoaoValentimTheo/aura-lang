// OOP: Static Members
class ConcreteC30867Gn {
    public static let instance_count: int = 0
    public static def increment_count() -> void { ConcreteC30867Gn.instance_count = ConcreteC30867Gn.instance_count + 1; }
    
    public let id: int
    
    def new(id: int) {
        self.id = id;
        ConcreteC30867Gn.increment_count();
    }
    
    public def get_id() -> int { return self.id; }
}

let obj1 = ConcreteC30867Gn(id: 1);
let obj2 = ConcreteC30867Gn(id: 2);
let obj3 = ConcreteC30867Gn(id: 3);

print(ConcreteC30867Gn.instance_count);
print(obj1.get_id());
print(obj3.get_id());
