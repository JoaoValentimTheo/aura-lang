// OOP: Builder Pattern
class MockC82539BsBuilder {
    private let name: str = ""
    private let age: int = 0
    private let email: str = ""
    
    public def with_name(n: str) -> MockC82539BsBuilder {
        self.name = n;
        return self;
    }
    
    public def with_age(a: int) -> MockC82539BsBuilder {
        self.age = a;
        return self;
    }
    
    public def build() -> MockC82539Bs {
        return MockC82539Bs(name: self.name, age: self.age, email: self.email);
    }
}

class MockC82539Bs {
    public let name: str
    public let age: int
    public let email: str
    
    def new(name: str, age: int, email: str = "") {
        self.name = name;
        self.age = age;
        self.email = email;
    }
}

let obj = MockC82539BsBuilder().with_name("Aura").with_age(30).build();
print(obj.name);
print(obj.age);
