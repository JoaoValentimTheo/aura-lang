// OOP: Static Members
class RealC67994Wx {
    public static let instance_count: int = 0
    public static def increment_count() -> void { RealC67994Wx.instance_count = RealC67994Wx.instance_count + 1; }
    
    public let id: int
    
    public def new(id: int) {
        self.id = id;
        RealC67994Wx.increment_count();
    }
    
    public def get_id() -> int { return self.id; }
}

let obj1 = RealC67994Wx(id: 1);
let obj2 = RealC67994Wx(id: 2);
let obj3 = RealC67994Wx(id: 3);

print(RealC67994Wx.instance_count);
print(obj1.get_id());
print(obj3.get_id());
