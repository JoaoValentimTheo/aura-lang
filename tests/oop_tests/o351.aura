// OOP: Deep Inheritance Chain (4 levels)
class ConcreteC16271Xz {
    protected let base_val: int = 48
    public def get_val() -> int { return self.base_val; }
}

class AbstractC45033Jp(ConcreteC16271Xz) {
    public def get_val() -> int { return self.base_val * 2; }
}

class AbstractC20188Of(AbstractC45033Jp) {
    public def get_val() -> int { return self.base_val * 3; }
}

class ConcreteC92529Xn(AbstractC20188Of) {
    public def get_val() -> int { return self.base_val * 4; }
}

let obj = ConcreteC92529Xn(base_val: 48);
print(obj.get_val());
