// OOP: Builder Pattern
class BaseC94300XcBuilder {
    private let name: str = ""
    private let age: int = 0
    private let email: str = ""
    
    public def with_name(n: str) -> BaseC94300XcBuilder {
        self.name = n;
        return self;
    }
    
    public def with_age(a: int) -> BaseC94300XcBuilder {
        self.age = a;
        return self;
    }
    
    public def build() -> BaseC94300Xc {
        return BaseC94300Xc(name: self.name, age: self.age, email: self.email);
    }
}

class BaseC94300Xc {
    public let name: str
    public let age: int
    public let email: str
    
    def new(name: str, age: int, email: str = "") {
        self.name = name;
        self.age = age;
        self.email = email;
    }
}

let obj = BaseC94300XcBuilder().with_name("Aura").with_age(30).build();
print(obj.name);
print(obj.age);
