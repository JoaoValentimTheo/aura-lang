// OOP: Polymorphism
class C17027Zh {
    public def render() -> str { return "base"; }
}

class C46968As(C17027Zh) {
    public def render() -> str { return "child1"; }
}

class RealC20867Gk(C17027Zh) {
    public def render() -> str { return "child2"; }
}

let objects = [C17027Zh(), C46968As(), RealC20867Gk()];
for obj in objects {
    print(obj.render());
}
