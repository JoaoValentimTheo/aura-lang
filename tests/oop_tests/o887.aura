// OOP: Static Factory Pattern
class BaseC38903Rh {
    private let value: int
    
    def new(value: int) { self.value = value; }
    
    public def get_value() -> int { return self.value; }
    
    public static def create_default() -> BaseC38903Rh {
        return BaseC38903Rh(value: 42);
    }
    
    public static def create_custom(val: int) -> BaseC38903Rh {
        return BaseC38903Rh(value: val);
    }
}

let obj1 = BaseC38903Rh.create_default();
let obj2 = BaseC38903Rh.create_custom(54);

print(obj1.get_value());
print(obj2.get_value());
