// OOP: Static Factory Pattern
class ConcreteC48497Rj {
    private let value: int
    
    public def new(value: int) { self.value = value; }
    
    public def get_value() -> int { return self.value; }
    
    public static def create_default() -> ConcreteC48497Rj {
        return ConcreteC48497Rj(value: 42);
    }
    
    public static def create_custom(val: int) -> ConcreteC48497Rj {
        return ConcreteC48497Rj(value: val);
    }
}

let obj1 = ConcreteC48497Rj.create_default();
let obj2 = ConcreteC48497Rj.create_custom(91);

print(obj1.get_value());
print(obj2.get_value());
