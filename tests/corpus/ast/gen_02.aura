struct Point { x: int, y: int }
impl Point { fn sum(self) -> int { return self.x + self.y } }
enum Color { Red, Green, Blue }
trait Show { fn show(self) -> int }
struct Num { n: int }
impl Show for Num { fn show(self) -> int { return self.n } }
fn id<T>(x: T) -> T { return x }
fn add(a: int, b: int) -> int { return a + b }
fn describe(c: Color) -> int { return match c { Red() -> 0
 Green() -> 1
 Blue() -> 2 } }
fn on_show<T: Show>(x: T) -> int { return x.show() }
fn main() {
    let mut l0 = [49]
    let mut l1 = [5, 39, 32]
    let p2 = Point { x: 15, y: 47 }
    let k3 = Green()
    push(l0, 98)
    print(len(l0))
    let mut i4 = describe(k3)
    push(l0, 89)
    print(len(l0))
    let mut c5 = []
    print(0)
}
