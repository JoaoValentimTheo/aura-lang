# Force LF for Aura source files on every platform.
#
# The permanent corpus (`tests/corpus/`) requires deterministic file contents,
# and the generator property test compares a committed fixture against the
# generator's LF output byte for byte. Without this, a Windows checkout would
# apply CRLF and the comparison would fail (and the corpus would not be
# deterministic across platforms).
*.aura text eol=lf

# Diagnostic expectation files are compared as text.
*.out text eol=lf

# The differential-oracle golden manifest is compared byte-for-byte against
# LF-only generator output (`golden_manifest_is_reproducible`), so a Windows
# checkout must not materialize it with CRLF.
tests/oracle/golden.tsv text eol=lf

# The B-1R3A iterative-engine golden is likewise compared byte-for-byte.
tests/oracle/r3a_golden.tsv text eol=lf

# The B-1R3B.1 unary iterative-engine golden is likewise byte-for-byte.
tests/oracle/r3b_golden.tsv text eol=lf

# The B-1R3B.2 eager-binary iterative-engine golden is likewise byte-for-byte.
tests/oracle/r3b2_golden.tsv text eol=lf

# The B-1R3B.3 short-circuit iterative-engine golden is likewise byte-for-byte.
tests/oracle/r3b3_golden.tsv text eol=lf

# The B-1R3B.4.1 list-construction iterative-engine golden is likewise
# byte-for-byte.
tests/oracle/r3b4_golden.tsv text eol=lf

# The B-1R3B.4.2 map-construction iterative-engine golden is likewise
# byte-for-byte.
tests/oracle/r3b42_golden.tsv text eol=lf

# The B-1R3B.5 range-construction iterative-engine golden is likewise
# byte-for-byte.
tests/oracle/r3b5_golden.tsv text eol=lf

# The B-1R3B.6 index/field iterative-engine golden is likewise byte-for-byte.
tests/oracle/r3b6_golden.tsv text eol=lf

# The line-ending fixtures must keep their exact bytes: `unicode/crlf.aura`
# contains CRLF and `unicode/cr.aura` contains lone CR specifically to exercise
# the lexer's handling of each. Marking them binary (`-text`) prevents git from
# normalizing them on checkout on any platform.
tests/corpus/unicode/crlf.aura -text
tests/corpus/unicode/cr.aura -text
