# Generated by cargo-fuzz.
target

# libFuzzer's working corpus: mutations accumulated during a run. Ignored so the
# repository does not accumulate binary noise. The curated, committed seeds live
# in `seeds/`; the CI jobs copy `seeds/<target>/*` into `corpus/<target>/`
# before fuzzing.
corpus

# Crash/timeout artifacts are never committed; a crash must be reproduced and
# converted into a permanent fixture under `tests/corpus/` (see its README).
artifacts

# Coverage reports.
coverage
